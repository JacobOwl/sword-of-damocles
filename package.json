{
  "name": "sword-of-damocles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A single-player political simulation of Syracuse.",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm test",
    "sim": "node scripts/sim.ts",
    "build": "node scripts/build-ui.ts",
    "census": "node scripts/census.ts",
    "museum": "node scripts/museum.ts",
    "replays": "node scripts/export-replays.ts",
    "dev": "vite",
    "walk": "node scripts/ui-walk.mjs",
    "replay-save": "node scripts/replay-save.ts",
    "story-sweep": "node scripts/story-sweep.ts",
    "debrief": "node scripts/debrief.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vite": "8.3.6",
    "vite-plugin-singlefile": "2.3.4"
  }
}
